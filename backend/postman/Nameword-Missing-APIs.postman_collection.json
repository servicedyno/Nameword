							"raw": "{{base_url}}/hosting-plans/renewal/wallet-payment",
							"host": ["{{base_url}}"],
							"path": ["hosting-plans", "renewal", "wallet-payment"]
						},
						"description": "Renew hosting via wallet. Auth required."
					},
					"response": []

						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 59.99,\n  \"domainCartItemId\": \"{{domain_cart_item_id}}\",\n  \"hostingCartItemId\": \"{{hosting_cart_item_id}}\",\n  \"walletAmount\": 0\n}"
						},
						"url": {
							"raw": "{{base_url}}/hosting-plans/bundle-dynocheckout-url",
							"host": ["{{base_url}}"],
							"path": ["hosting-plans", "bundle-dynocheckout-url"]
						},
						"description": "Get DynoPay checkout URL for domain+hosting bundle. Auth required."
					},
					"response": []
				},
				{
					"name": "Hosting Wallet Payment",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 49.99,\n  \"cartItemIds\": [\"{{cart_item_id}}\"]\n}"
						},
						"url": {
							"raw": "{{base_url}}/hosting-plans/wallet-payment",
							"host": ["{{base_url}}"],
							"path": ["hosting-plans", "wallet-payment"]
						},
						"description": "Pay for hosting using wallet balance. Auth required."
					},
					"response": []
				},

						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"domain_name\": \"example.com\",\n  \"plan\": \"starter\",\n  \"period\": 12,\n  \"domain_type\": \"existing\"\n}"

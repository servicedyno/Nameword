						"url": {
							"raw": "{{base_url}}/hosting-plans/domains/:domain_name/link",
							"host": ["{{base_url}}"],
							"path": ["hosting-plans", "domains", ":domain_name", "link"],
							"variable": [{ "key": "domain_name", "value": "example.com" }]
						},

						"url": {
							"raw": "{{base_url}}/hosting-plans/hosting/:subscription_id/addon-domains",
							"host": ["{{base_url}}"],
							"path": ["hosting-plans", "hosting", ":subscription_id", "addon-domains"],
							"variable": [{ "key": "subscription_id", "value": "" }]

{
	"info": {
		"_postman_id": "nameword-missing-apis-001",
		"name": "Nameword - Missing APIs",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"description": "Cart, Hosting Plans, Wallet, Tax, Promo, Invoices, User Session, and additional Domain endpoints. Set base_url to http://localhost:3000/api/v1 (or your API URL). Use x-api-key and Authorization Bearer for auth-required endpoints."
	},
	"item": [
		{
			"name": "Cart",
			"item": [
				{
					"name": "Add to Cart",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "x-api-key", "value": "{{api_key}}", "disabled": true },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"itemType\": \"domain\",\n  \"websiteName\": \"example.com\",\n  \"action\": \"register\",\n  \"years\": 1,\n  \"whoisProtection\": true,\n  \"price\": { \"amount\": 12.99, \"currency\": \"USD\" }\n}"
						},
						"url": {
							"raw": "{{base_url}}/cart/add",
							"host": ["{{base_url}}"],
							"path": ["cart", "add"]
						},
						"description": "Add domain, bundle, or hosting to cart. itemType: domain|bundle|hosting. Domain needs: websiteName, action(register|transfer|renew), years, price. Hosting needs: hosting.planName, hosting.provider, hosting.planId, hosting.domainOption, hosting.domainName (if new), price."
					},
					"response": []
				},
				{
					"name": "List Cart",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{base_url}}/cart/list?markRead=false",
							"host": ["{{base_url}}"],
							"path": ["cart", "list"],
							"query": [{ "key": "markRead", "value": "false", "description": "Optional" }]
						},
						"description": "Get current user's cart items. Requires auth."
					},
					"response": []
				},
				{
					"name": "Remove from Cart",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{base_url}}/cart/remove?id={{cart_item_id}}",
							"host": ["{{base_url}}"],
							"path": ["cart", "remove"],
							"query": [{ "key": "id", "value": "{{cart_item_id}}", "description": "MongoDB ObjectId of cart item" }]
						},
						"description": "Remove item from cart. Query param: id (MongoId)."
					},
					"response": []
				},
				{
					"name": "Checkout Cart",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"payment_status\": \"success\",\n  \"walletTransactionId\": \"{{transaction_id}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/cart/checkout",
							"host": ["{{base_url}}"],
							"path": ["cart", "checkout"]
						},
						"description": "Process cart checkout. Requires auth."
					},
					"response": []
				},
				{
					"name": "Clear Cart",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{base_url}}/cart/clear",
							"host": ["{{base_url}}"],
							"path": ["cart", "clear"]
						},
						"description": "Clear all items from cart. Requires auth."
					},
					"response": []
				},
				{
					"name": "Update Cart",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": \"{{cart_item_id}}\",\n  \"years\": 2,\n  \"price\": { \"amount\": 24.99 },\n  \"whoisProtection\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/cart/update",
							"host": ["{{base_url}}"],
							"path": ["cart", "update"]
						},
						"description": "Update cart item. Requires auth."
					},
					"response": []
				}
			]
		},
		{
			"name": "Hosting Plans",
			"item": [
				{
					"name": "Get Hosting Plans",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/hosting-plans/plans?provider=both",
							"host": ["{{base_url}}"],
							"path": ["hosting-plans", "plans"],
							"query": [
								{ "key": "provider", "value": "both", "description": "hostbay|connectreseller|both" },
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "50" }
							]
						},
						"description": "Fetch hosting plans. No auth required."
					},
					"response": []
				},
				{
					"name": "Calculate Hosting Price",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/hosting-plans/calculate-price?plan=starter&period=12&provider=hostbay",
							"host": ["{{base_url}}"],
							"path": ["hosting-plans", "calculate-price"],
							"query": [
								{ "key": "plan", "value": "starter", "description": "Required. Plan code" },
								{ "key": "period", "value": "12", "description": "Optional. Default 1" },
								{ "key": "provider", "value": "hostbay", "description": "Optional" }
							]
						},
						"description": "Calculate price for a hosting plan."
					},
					"response": []
				},
				{
					"name": "Hosting DynoCheckout URL",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 49.99,\n  \"cartItemIds\": [\"{{cart_item_id}}\"],\n  \"walletAmount\": 0\n}"
						},
						"url": {
							"raw": "{{base_url}}/hosting-plans/dynocheckout-url",
							"host": ["{{base_url}}"],
							"path": ["hosting-plans", "dynocheckout-url"]
						},
						"description": "Get DynoPay checkout URL for hosting. Auth required."
					},
					"response": []
				},
				{
					"name": "Bundle DynoCheckout URL",

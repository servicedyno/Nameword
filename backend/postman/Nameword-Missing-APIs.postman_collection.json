						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"subscriptionId\": \"{{subscription_id}}\",\n  \"period\": 12,\n  \"amount\": 49.99,\n  \"plan\": null,\n  \"walletAmount\": 0,\n  \"autoRenew\": true\n}"
						},

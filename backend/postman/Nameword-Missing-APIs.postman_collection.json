						"url": {
							"raw": "{{base_url}}/hosting-plans/ssl/install",
							"host": ["{{base_url}}"],
							"path": ["hosting-plans", "ssl", "install"]
						},
						"description": "Install SSL certificate. Auth required."
					},
					"response": []
